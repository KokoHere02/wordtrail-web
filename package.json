{
  "name": "wordtrail-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types node_modules/vite/bin/vite.js --configLoader native",
    "build": "vue-tsc -b && node --experimental-strip-types node_modules/vite/bin/vite.js build --configLoader native",
    "preview": "node --experimental-strip-types node_modules/vite/bin/vite.js preview --configLoader native",
    "dev:mock": "node --experimental-strip-types node_modules/vite/bin/vite.js --configLoader native --mode mock",
    "typecheck": "vue-tsc -b",
    "test:e2e": "playwright test",
    "test:contracts": "node tests/contract-check.mjs",
    "test:ui": "node tests/ui-check.mjs",
    "dev:api": "node --experimental-strip-types node_modules/vite/bin/vite.js --configLoader native --mode api",
    "dev:preview": "node --experimental-strip-types node_modules/vite/bin/vite.js --configLoader native --mode preview",
    "test:daily": "node tests/daily-check.mjs",
    "test:daily-training": "node tests/daily-training-check.mjs",
    "test:daily-continuation": "node tests/daily-continuation-check.mjs",
    "test:follow-typing:browser": "playwright test --config playwright.follow.config.ts",
    "test:follow-typing": "node tests/follow-typing-check.mjs",
    "test:learning-expansion": "node tests/learning-expansion-check.mjs && node tests/learning-expansion-ui-check.mjs",
    "test:learning-expansion:browser": "playwright test --config playwright.expansion.config.ts",
    "test:daily-training:live": "node tests/daily-training-live.mjs",
    "test:api-ui": "node tests/api-ui-check.mjs",
    "test:books": "node tests/books-check.mjs",
    "test:words": "node tests/words-check.mjs",
    "test:insights": "node tests/insights-check.mjs",
    "test:translation": "node tests/translation-check.mjs",
    "test:review": "playwright test --config playwright.review.config.ts",
    "test:book-transfer": "node tests/book-transfer-check.mjs",
    "test:book-transfer:browser": "playwright test --config playwright.book-transfer.config.ts",
    "test:dictation": "node tests/dictation-check.mjs",
    "test:dictation:browser": "playwright test --config playwright.dictation.config.ts",
    "test:sentences": "node tests/sentences-check.mjs",
    "test:sentences:expansion": "node tests/sentence-expansion-check.mjs",
    "test:learning-links": "node tests/learning-links-check.mjs",
    "test:account-security": "node tests/account-security-check.mjs",
    "test:learning-links:browser": "playwright test --config playwright.links.config.ts",
    "test:workspace": "node tests/workspace-check.mjs",
    "test:workspace:browser": "playwright test --config playwright.workspace.config.ts",
    "test:sentences:browser": "playwright test --config playwright.sentences.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
